{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/checkout.js": {
      "includeFiles": "lib/catalog.json"
    }
  },
  "rewrites": [
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/account.html"
    }
  ]
}
