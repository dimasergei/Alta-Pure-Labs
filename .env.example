# PURE — safe environment template for developers
# Generated for the CURRENT production architecture; intentionally contains NO live values.
# Do not commit a populated .env or .env.local; .gitignore now excludes both.
# Existing protected production credentials remain managed by Vercel.
# The current domain stays unchanged unless a separate release approves switching it.

# Public site, Supabase and session authentication
SITE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin, order notifications, customer security
ADMIN_AUTH_EMAIL=
ADMIN_AUTH_SIGNING_SECRET=
ADMIN_ORDERS_PASSWORD=
ADMIN_ORDER_EMAIL=
ORDER_CONFIRMATION_FROM=
RESEND_API_KEY=
CHECKOUT_RATE_LIMIT_SECRET=
COMMERCE_NOTIFICATION_JOB_SECRET=
PARTNER_BANK_ENCRYPTION_KEY=

# Active payment method: Rampex card-to-crypto
RAMPEX_ENABLED=
RAMPEX_API_KEY=
RAMPEX_WEBHOOK_SECRET=

# Active payment method: PURE Crypto, Polygon USDC
POLYGON_USDC_ENABLED=
POLYGON_USDC_RECIPIENT=
POLYGON_USDC_RPC_URL=
POLYGON_USDC_SECONDARY_RPC_URL=

# Active bank transfer and Interac method details live in Supabase;
# these are NOT configured via retired gateway secrets.
SHIPPING_FLAT_RATE_CENTS=

# Shippo labels, tracking and shipping verification
SHIPPO_MODE=
SHIPPO_ALLOW_LIVE_PURCHASES=
SHIPPO_API_TOKEN=
SHIPPO_TEST_TOKEN=
SHIPPO_VERIFY_ON_BUILD=
SHIPPO_VERIFY_TRANSACTION_ID=

# Marketing / Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Legacy Stripe reconciliation ONLY; DO NOT enter new Stripe account keys here.
# Production's old Stripe account is closed, and these historical keys are
# retained in Vercel until reconciliation and migration are separately approved.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# LIVE_CHECKOUT_ENABLED=
# CHECKOUT_ENABLED=

# Retired/inactive: no Lotus, PeptidePay, or Tagada fields are included.
# Vercel SYSTEM fields (VERCEL_*, OIDC) are injected by Vercel; do not copy them.
